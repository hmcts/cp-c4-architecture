model {
    extend cp.case-administration-subdomain {
        work-management-system = product {
            title 'Work Management System'
            description 'Manages work queues for case activity tasks'

            ctsc_manager -> work-management-system 'Manages CTSC team\'s activity/task workload'
            ctsc_manager -> camunda-optimize 'Reviews dashboards and team performance metrics'
            ctsc_staff -> work-management-system 'Actions activity/tasks to provide support and helpdesk functions'

            work-management-ui = user-interface {
                title 'Work Management UI'
                technology 'Angular'
                summary 'Provides functionality for managing CP activities (tasks)'
                metadata {
                    language 'TypeScript'
                    software-framework 'Angular'
                }
                style {
                    icon tech:angular
                }
                link https://github.com/hmcts/cpp-ui-work-management 'Repository'

                this -> work-management-proxy 'makes API calls to'

                ctsc_manager -> this 'Manages CTSC activity workloads'
                ctsc_staff -> this 'Action CTSC activities'
            }

            work-management-proxy = microservice {
                title 'Work Management Proxy'
                technology 'Java EE'
                metadata {
                    language 'Java'
                    software-framework 'Java EE 8'
                }
                link https://github.com/hmcts/cpp-context-work-management-proxy 'Repository'
                this -> business-process-service 'makes API calls to'
                this -[audit]-> cp.audit-system.audit-message-broker 'sends data to'
            }


            business-process-service = microservice {
                title 'Business Process Service'
                technology 'Java EE'
                metadata {
                    language 'Java'
                    software-framework 'Java EE 8'
                }
                link https://github.com/hmcts/cpp-context-businessprocesses 'Repository'
                this -> camunda 'makes API calls to'
                this -[mi]-> cp.management-information-system.mi-report-data-service 'sends data to'
                this -[audit]-> cp.audit-system.audit-message-broker 'sends data to'
                cp.hearing-service -> this 'Sends hearing outcome updates to update business process activities'
                cp.prosecution-case-file-service -> this 'Sends case creation failures to update business process activities'
                cp.progression-service -> this 'Sends case record updates to update business process activities'
                cp.sjp-service -> this 'Sends SJP case record updates to update business process activities'
                cp.listing-service -> this 'Sends hearing scheduling updates to update business process activities'
                cp.defence-service -> this 'Sends defence case updates to update business process activities'
                // TODO @matthew.rich Needs to be created
                //cp.correspondence-service -> this 'Creates & Updates Tasks'
            }

            box-work-management-service = microservice {
                title 'Box Work Management Service'
                technology 'Java EE'
                summary 'Event processor that tracks court applications referred to boxwork through an embedded Camunda workflow, from referral until the box hearing is resulted'
                description """
Runs a single Camunda process (`boxworkApplication`) on an embedded process engine; it has no command or query API.

1. **Referral**: when Progression publishes `public.progression.boxwork-application-referred` for a box hearing, starts one process instance per court application (keyed by application ID)
2. **Create Boxwork task**: a service task that currently only logs; it creates no user task
3. **Wait for result**: the process waits until Hearing publishes `public.events.hearing.hearing-resulted` for the box hearing, then completes and publishes `public.boxwork-application-completed`

No service has been found that subscribes to `public.boxwork-application-completed`.
"""
                metadata {
                    language 'Java'
                    software-framework 'Java EE 8'
                }
                link https://github.com/hmcts/cpp-context-boxworkmanagement 'Repository'
                this -> camunda-database 'stores boxwork process instances in'
                this -[audit]-> cp.audit-system.audit-message-broker 'sends data to'
                cp.case-management-system.progression-service -> this 'refers court applications for box hearings to'
                cp.hearing-system.hearing-service -> this 'notifies box hearing results to'
            }

            camunda = application {
                title 'Camunda'
                technology 'Camunda'
                this -> camunda-database
            }

            camunda-optimize = application {
                title 'Camunda Optimize'
                technology 'Camunda'
                this -> camunda-database
            }

            camunda-database = datastore {
                title 'Camunda Database'
                technology 'PostgreSQL'
                summary 'Stores workflow processes and acitivity (Task) information'
                style {
                    icon tech:postgresql
                }
            }
        }
    }
}