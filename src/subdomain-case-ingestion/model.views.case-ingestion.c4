views 'Case Ingestion / SPI' {
    view spi-system-context of cp.spi {
        title '[System Context] SPI'
        include *
        where
            not (kind is application or kind is microservice or kind is functions or kind is datastore or kind is user-interface or kind is component)
        include cp.case-administration-subdomain._
        include cp.court-hearings-subdomain._
        include cp.shared-components-subdomain._
            where kind is product
        exclude * -> *
        include * <-> cp.spi
        exclude * <-> *
            where kind is audit or kind is mi or kind is auth or kind is shared

        style cp.case-administration-subdomain.*, cp.court-hearings-subdomain.*, cp.shared-components-subdomain.* {
            color secondary
        }
    }

    view spi-container-view of cp.spi {
        title '[Container View] SPI'
        include *
        include cp.case-administration-subdomain._
        include cp.court-hearings-subdomain._
        include cp.shared-components-subdomain._
            where kind is product
        exclude * -> *
        include * <-> cp.spi._
        include cp.spi._ <-> cp.spi._
        exclude * <-> *
            where kind is mi or kind is auth or kind is shared

        style cp.case-administration-subdomain.*, cp.court-hearings-subdomain.*, cp.shared-components-subdomain.* {
            color secondary
        }
    }
}

