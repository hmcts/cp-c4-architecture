model {
    extend cp.scheduling-and-listing-subdomain {
        scheduling-and-listing-system = product {
            title 'Scheduling and Listing System'
            summary 'Allows management of court schedules, booking of hearings and the publication of listings'

            listing-ui = user-interface {
                title 'Listing UI'
                technology 'Angular'
                summary 'Provides functionality for allocating hearings, managing court calendars, and publishing court lists'
                metadata {
                    language 'TypeScript'
                    software-framework 'Angular'
                }
                style {
                    icon tech:angular
                }
                link https://github.com/hmcts/cpp-ui-listing 'Repository'
                this -> listing-service 'allocates hearings and requests court list publication using' {
                    technology 'JSON/HTTPS'
                }
                this -> court-list-publishing-service 'publishes and downloads court lists using' {
                    technology 'JSON/HTTPS'
                }
                this -> cp.case-management-system.progression-service 'retrieves court list data and case notes from' {
                    technology 'JSON/HTTPS'
                }
                this -> cp.hearing-system.hearing-service 'marks hearings as duplicates using' {
                    technology 'JSON/HTTPS'
                }
                this -[notify]-> cp.notification-notify 'emails judiciary and listing officers about allocation changes using'

                listing_officer -> this 'allocates hearings using'
                legal_advisor -> this 'manages hearings in court and advises magistrates'
                court_admin -> this 'maintains and manages court diary using'
                court_clerk -> this 'runs court room logistics on hearing day using'

            }

            court-scheduler-ui = user-interface {
                title 'Court Scheduler UI'
                technology 'Angular'
                summary 'Provides functionality for managing court schedules'
                metadata {
                    language 'TypeScript'
                    software-framework 'Angular'
                }
                style {
                    icon tech:angular
                }
                link https://github.com/hmcts/cpp-ui-courtscheduler 'Repository'

                this -> api 'manages court schedules and judicial itineraries using' {
                    technology 'JSON/HTTPS'
                }
                this -[shared]-> cp.reference-data 'maintains judiciary specialisms in'

                listing_officer -> this 'manages court schedule using'

            }

            listing-service = microservice {
                title 'Listing Service'
                technology 'Java EE'
                summary 'Manages court listings'
                metadata {
                    language 'Java'
                    software-framework 'Java EE 8'
                }

                link https://github.com/hmcts/cpp-context-listing 'Repository'

                this -> listing-database 'stores events and hearing entities in'
                this -> cp.case-management-system.progression-service 'retrieves prosecution case data from' {
                    technology 'JSON/HTTPS'
                }
                this -> cp.advocate-portal.defence-service 'looks up cases by person or organisation defendant using' {
                    technology 'JSON/HTTPS'
                }

                this -> xhibit 'sends Crown Court lists to' {
                    technology 'XML over WebDAV via Xhibit Gateway'
                }
                this -[auth]-> cp.users-and-groups 'makes authorisation decisions using'
                this -[mi]-> cp.management-information-system.mi-report-data-service 'sends data to'
                this -[audit]-> cp.audit-system.audit-message-broker 'sends data to'
                this -[shared]-> cp.document-generator 'generates court list PDFs using'
                this -[shared]-> cp.reference-data 'gets reference data from'

                command-api = component {
                    title 'Command API'
                    technology 'Java'

                    this -> court-scheduler-service.api 'books and vacates hearings using'
                }
            }

            court-scheduler-service = microservice {
                title 'Court Scheduler Service'
                technology 'Java EE'
                summary 'Manages court schedules'
                metadata {
                    language 'Java'
                    software-framework 'Java EE 8'
                }

                link https://github.com/hmcts/cpp-context-listing-courtscheduler 'Repository'

                this -> scsl-database
                this -> cp.shared-components-subdomain.redis-cache-system.redis-cache.redis-db-0 'caches scheduling reference data in'
                this -[auth]-> cp.users-and-groups 'makes authorisation decisions using'
                this -[audit]-> cp.audit-system.audit-message-broker 'sends data to'
                this -[shared]-> cp.reference-data 'gets reference data from'

                api = component {
                    title 'Court Scheduler API'
                    technology 'Java Component'
                    summary 'REST API for other services in the system'

                    this -> rota-file-processor
                    this -> common-service
                }

                rota-file-processor = component {
                    title 'Rota File Processor'
                    technology 'Java Component'
                    summary 'API for Rota file processing'

                    rota -> this "sends court schedules to"
                    this -> common-service
                    cp.system-scheduling -[shared]-> this 'triggers overnight Rota file processing'
                }

                common-service = component {
                    title 'Common Service'
                    technology 'Java Component'
                    summary 'Business logic'

                    this -> view-store-persistance-service
                }

                view-store-persistance-service = component {
                    title 'View Store Persistance Service'
                    technology 'Java Component'
                    summary 'CRUD Repository'

                    this -> scsl-database
                }
            }

            staging-pub-hub-service = microservice {
                title 'Staging Pub Hub'
                technology 'Java EE'
                summary 'Publishes magistrates standard lists, Crown Court live case status, and SJP public and press lists to CaTH; being partially superseded by the Court List Publishing Service'
                metadata {
                    language 'Java'
                    software-framework 'Java EE 8'
                }

                link https://github.com/hmcts/cpp-context-staging-pubhub 'Repository'

                cp.case-management-system.progression-service -> this 'sends enriched standard court lists to'
                cp.case-management-system.sjp-service -> this 'publishes SJP public and press list events to'
                cp.hearing-system.hearing-service -> this 'publishes Crown Court live case status events to'
                this -> cath 'publishes court lists to' {
                    technology 'JSON/HTTPS via APIM Publishing Hub'
                }
                this -[audit]-> cp.audit-system.audit-message-broker 'sends data to'
                this -[shared]-> cp.reference-data 'looks up courtroom reference data from'
            }

            listing-database = datastore {
                title 'Listing Database'
                technology 'PostgreSQL'
                summary 'Stores events and entities'
                style {
                    icon tech:postgresql
                }
            }

            scsl-database = datastore {
                title 'SCSL Database'
                technology 'PostgreSQL'
                summary 'Stores events and entities'
                style {
                    icon tech:postgresql
                }
            }

            court-schedule-service = microservice {
                title 'Court Schedule Service'
                technology 'Spring Boot'
                summary 'Provides court schedule data for a given case URN via the API Marketplace'
                metadata {
                    language 'Java'
                    software-framework 'Spring Boot'
                }
                link https://github.com/hmcts/service-cp-crime-scheduleandlist-courtschedule 'Repository'

                track-a-case -[api-marketplace]-> this 'gets court schedule'
                this -[api-marketplace]-> cp.case-urn-mapper 'resolves case URN to case ID using'
                this -> listing-service 'fetches hearing data from'
            }

            court-list-publishing-service = microservice {
                title 'Court List Publishing Service'
                technology 'Spring Boot'
                summary 'Publishes magistrates court lists to CaTH and generates court list PDF and Word documents; progressively replacing the Staging Pub Hub publication routes (an SJP list endpoint exists but is not yet called by SJP)'
                metadata {
                    language 'Java'
                    software-framework 'Spring Boot'
                }
                link https://github.com/hmcts/cp-court-list-publishing-service 'Repository'

                this -> cath 'publishes court lists to' {
                    technology 'JSON/HTTPS via APIM Publishing Hub'
                }
                this -> listing-service 'retrieves court list payloads from' {
                    technology 'JSON/HTTPS'
                }
                this -> cp.case-management-system.progression-service 'retrieves enriched court list data from' {
                    technology 'JSON/HTTPS'
                }
                this -> court-list-publishing-database 'records publication status in'
                this -> court-list-publishing-blob-storage 'stores CaTH payloads and generated court list documents in'
                this -[shared]-> cp.reference-data 'looks up courtroom and enforcement area reference data from'
                this -[shared]-> cp.document-generator 'renders court list PDF and Word documents using'
                this -[audit]-> cp.audit-system.audit-message-broker 'sends data to'
            }

            court-list-publishing-database = datastore {
                title 'Court List Publishing Database'
                technology 'PostgreSQL'
                summary 'Stores court list publication status'
                style {
                    icon tech:postgresql
                }
            }

            court-list-publishing-blob-storage = datastore {
                title 'Court List Publishing Blob Storage'
                technology 'Azure Blob Storage'
                summary 'Stores CaTH JSON payloads and generated court list PDFs'
                style {
                    icon azure:storage-accounts
                }
            }
        }
    }
}
